#!/bin/sh
#
# NetworkManager dispatcher script: re-apply the captive-portal port-80 nft
# redirect whenever the duck AP interface comes up (so it survives reboots and
# connection cycles). Installed to /etc/NetworkManager/dispatcher.d/90-duck-captive
# (must be root-owned + executable). Runs as root.

IFACE="$1"
ACTION="$2"

# Only act on the AP interface.
[ "$IFACE" = "wlan0" ] || exit 0

case "$ACTION" in
    up|dhcp4-change|connectivity-change)
        [ -f /etc/duck-captive.nft ] && /usr/sbin/nft -f /etc/duck-captive.nft 2>/dev/null || true
        ;;
    down)
        /usr/sbin/nft delete table ip duckcaptive 2>/dev/null || true
        ;;
esac
exit 0
